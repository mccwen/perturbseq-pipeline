configfile: "config/analysis.yaml"

from pathlib import Path

import yaml

from perturbseq_pipeline.inputs import configured_input_paths


ANALYSIS_CONFIG = Path("config/analysis.yaml").resolve()
PROJECT_ROOT = Path.cwd().resolve()


def project_path(path):
    """Keep workflow-generated configuration paths repository-relative."""
    resolved = Path(path).resolve()
    try:
        return str(resolved.relative_to(PROJECT_ROOT))
    except ValueError:
        return str(path)


INPUT_CONFIG = next(
    (
        project_path(path)
        for path in workflow.configfiles
        if Path(path).resolve() != ANALYSIS_CONFIG
    ),
    None,
)
if not INPUT_CONFIG or "input" not in config:
    raise ValueError(
        "Select an input configuration with --configfile config/demo_h5ad.yaml "
        "or config/demo_csv.yaml"
    )

RESOLVED_CONFIG = "data/processed/00_input/resolved_config.yaml"
CONFIG_SOURCES = ["config/analysis.yaml", INPUT_CONFIG]


def configured_input_files(wildcards):
    return [str(path) for path in configured_input_paths(config)]


def configured_provenance_files(wildcards):
    return configured_input_files(wildcards) + [
        config["guide_assignment"]["reference"],
        config["pathway_analysis"]["gene_sets"],
        "environment.yml",
    ]


rule resolve_config:
    input:
        CONFIG_SOURCES
    output:
        RESOLVED_CONFIG
    run:
        destination = Path(output[0])
        destination.parent.mkdir(parents=True, exist_ok=True)
        resolved = dict(config)
        resolved["input_config"] = INPUT_CONFIG
        destination.write_text(yaml.safe_dump(resolved, sort_keys=False))

