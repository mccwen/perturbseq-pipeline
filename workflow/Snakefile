rule report:
    input:
        qc="data/processed/01_qc/qc_metrics.csv",
        low_moi="data/processed/02_guides/low_moi_qc_summary.csv",
        batch="data/processed/03_batch/batch_metrics.csv",
        guide_batch_sample="data/processed/03_batch/guide_capture_by_sample.csv",
        guide_batch_tests="data/processed/03_batch/guide_batch_tests.csv",
        guide_batch_composition="data/processed/03_batch/guide_composition_by_batch.csv",
        gate_diagnostics="data/processed/03_design_gate/confounding_diagnostics.csv",
        gate_decision="data/processed/03_design_gate/decision.json",
        mixscape="data/processed/03_mixscape/mixscape_scores.csv",
        contrasts="data/processed/05_de/contrast_summary.csv",
        de="data/processed/05_de/de_results.csv",
        sensitivity_contrasts="data/processed/05_de/ko_only_contrast_summary.csv",
        sensitivity_de="data/processed/05_de/ko_only_de_results.csv",
        pathway="data/processed/06_visualization/pathway_results.csv",
        config=RESOLVED_CONFIG
    output:
        html="results/final_reports/summary_dashboard.html"
    shell:
        "python -m perturbseq_pipeline report --config {input.config} --qc {input.qc} "
        "--low-moi {input.low_moi} --batch {input.batch} "
        "--guide-batch-sample {input.guide_batch_sample} "
        "--guide-batch-tests {input.guide_batch_tests} "
        "--guide-batch-composition {input.guide_batch_composition} "
        "--gate-diagnostics {input.gate_diagnostics} --gate-decision {input.gate_decision} "
        "--mixscape {input.mixscape} --contrasts {input.contrasts} --de {input.de} "
        "--sensitivity-contrasts {input.sensitivity_contrasts} "
        "--sensitivity-de {input.sensitivity_de} --pathway {input.pathway} "
        "--output {output.html}"
