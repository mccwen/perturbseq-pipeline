        recommendations="data/processed/03_batch/batch_recommendations.md",
        plots="data/processed/03_batch/batch_plots.pdf"
    shell:
        "python -m perturbseq_pipeline batch --config {input.config} --adata {input.adata} "
        "--metadata {input.metadata} --metrics {output.metrics} "
        "--recommendations {output.recommendations} --plots {output.plots}"


