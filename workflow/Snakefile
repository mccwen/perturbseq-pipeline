rule mixscape_diagnosis:
    input:
        counts="data/processed/00_input/expression.mtx",
        genes="data/processed/00_input/genes.tsv",
        barcodes="data/processed/00_input/barcodes.tsv",
        metadata="data/processed/03_batch/cell_metadata_with_guides.csv"
    output:
        scores="data/processed/03_mixscape/mixscape_scores.csv",
        plots="data/processed/03_mixscape/mixscape_plots.pdf"
    params:
        reference=config["mixscape"]["reference"],
        split_by=config["mixscape"]["split_by"],
        neighbors=config["mixscape"]["num_neighbors"],
        min_cells=config["mixscape"]["min_cells_per_target"],
        min_de_genes=config["mixscape"]["min_de_genes"],
        probability_threshold=config["mixscape"]["perturbed_probability_threshold"]
    script:
        "scripts/run_mixscape.R"


