rule prepare_inputs:
    input:
        config=RESOLVED_CONFIG,
        sources=configured_input_files
    output:
        adata="data/processed/00_input/analysis.h5ad",
        matrix="data/processed/00_input/expression.mtx",
        genes="data/processed/00_input/genes.tsv",
        barcodes="data/processed/00_input/barcodes.tsv",
        metadata="data/processed/00_input/cell_metadata.csv"
    shell:
        "python -m perturbseq_pipeline prepare-inputs "
        "--config {input.config} --adata-out {output.adata} --matrix-out {output.matrix} "
        "--genes-out {output.genes} --barcodes-out {output.barcodes} "
        "--metadata-out {output.metadata}"


