rule guide_calling:
    input:
        adata="data/processed/00_input/analysis.h5ad",
        guide_reference=config["guide_assignment"]["reference"],
        config=RESOLVED_CONFIG
    output:
        assignments="data/processed/02_guides/guide_assignments.csv",
        summary="data/processed/02_guides/guide_qc_summary.csv",
        low_moi_summary="data/processed/02_guides/low_moi_qc_summary.csv"
    shell:
        "python -m perturbseq_pipeline guides --config {input.config} "
        "--adata {input.adata} --guide-reference {input.guide_reference} "
        "--assignments {output.assignments} --summary {output.summary} "
        "--low-moi-summary {output.low_moi_summary}"


rule merge_metadata:
    input:
        metadata="data/processed/00_input/cell_metadata.csv",
        assignments="data/processed/02_guides/guide_assignments.csv",
        qc="data/processed/01_qc/qc_metrics.csv"
    output:
        merged="data/processed/03_batch/cell_metadata_with_guides.csv"
    run:
        import pandas as pd

        meta = pd.read_csv(input.metadata)
        guides = pd.read_csv(input.assignments)
        qc_metrics = pd.read_csv(input.qc)
        merged = meta.merge(guides, on="cell_barcode", how="left").merge(
            qc_metrics, on="cell_barcode", how="left"
        )
        guide_eligible = merged["guide_assignment"].eq(
            config["experiment"]["primary_analysis_guide_class"]
        )
        if not config["experiment"]["include_non_targeting_controls"]:
            guide_eligible &= ~merged["is_non_targeting"].fillna(False)
        merged["include_primary_analysis"] = (
            guide_eligible
            & merged["pass_qc"].fillna(False)
            & ~merged["predicted_doublet"].fillna(True)
        )
        merged["analysis_exclusion_reason"] = ""
        merged.loc[~guide_eligible, "analysis_exclusion_reason"] = "not_single_guide"
        merged.loc[~merged["pass_qc"].fillna(False), "analysis_exclusion_reason"] = "cell_qc"
        merged.loc[
            merged["predicted_doublet"].fillna(True), "analysis_exclusion_reason"
        ] = "transcriptomic_doublet"
        merged.to_csv(output.merged, index=False)


rule batch_diagnosis:
    input:
        adata="data/processed/00_input/analysis.h5ad",
        metadata="data/processed/03_batch/cell_metadata_with_guides.csv",
        config=RESOLVED_CONFIG
